    {
        "slide_number": 5,
        "title": "FIRST PRINCIPLE",
        "text_blocks": [
            {
                "text": "Exentropic Ideas",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "Force-X",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "Force-X is the  fusion of physics-based modeling and neural network-based deep machine  learning. Force-X maps first-principles (thermodynamics, kinetics, and hydrodynamics) against real-time sensor streams. This combination provides unmatched predictive insight and asset optimization.",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "SIMULATION",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "MODEL",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "TRAINING",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "DATA",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "HYBRID",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "DIGITAL TWIN",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "ORCHESTRATION AND",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "CASE DEFINITION LAYER",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "DEEP NEURAL NETWORK (DNN) ALGORITHM",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "VALIDATION",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "DATA",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "R2 > 0.95",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "MASS, ENERGY & MOMENTUM BALANCE,",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "THERMODYNAMICS, KINETICS, UNIT OPERATIONS",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "No Hype. No AI Hallucinations.",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "ML Based Digital Twins",
                "level": 0,
                "is_bullet": false
            },
            {
                "text": "Need Near-Infinite Plant Data to Map All Variables.",
                "level": 1,
                "is_bullet": true
            },
            {
                "text": "Plant Mass Balance Error 2-5%",
                "level": 1,
                "is_bullet": true
            },
            {
                "text": "Can’t Accurately Map Highly Non-Linear Relationships",
                "level": 1,
                "is_bullet": true
            },
            {
                "text": "Accuracy Range Between 80%-90%",
                "level": 1,
                "is_bullet": true
            },
            {
